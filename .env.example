# ==========================================================
# Variables d'env pour la stack Docker locale (à copier en .env)
#   cp .env.docker .env
#   docker compose exec app php artisan key:generate
# NE PAS UTILISER EN PRODUCTION
# ==========================================================
APP_NAME="Relations Publics Afrique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (service `mysql` dans docker-compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=relationspublicsafrique
DB_USERNAME=rpa_user
DB_PASSWORD=rpa_password
DB_ROOT_PASSWORD=root

# --- Ports exposés à l'hôte (modifiable) ---
APP_PORT=8080
DB_PORT_HOST=3307
PMA_PORT=8081
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Cache / session / queue (sync = simple en dev) ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Mail (MailHog, UI sur http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@rpa.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis (optionnel — service non lancé par défaut) ---
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Admin RPA, id=19
# admin@rpa.local
# Admin@RPA2026!
# --- Annuaire (feature 001-annuaire-evolution) ---
ANNUAIRE_PER_PAGE=24
ANNUAIRE_CONSENTEMENT_EXPIRY_DAYS=90
ANNUAIRE_RATE_LIMIT_PUBLIC=60
