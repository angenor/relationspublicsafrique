# ==========================================================
# Dépendances (réinstallées via composer/npm au déploiement)
# ==========================================================
/vendor
/node_modules
/public/hot
/public/storage
public/storage000
/public/build

# ==========================================================
# Storage Laravel (généré à l'exécution)
# ==========================================================
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
!/storage/framework/cache/data/
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/debugbar/*
!/storage/debugbar/.gitkeep

# ==========================================================
# Bootstrap (cache Laravel)
# ==========================================================
/bootstrap/cache/*.php
!/bootstrap/cache/.gitkeep

# ==========================================================
# Environnement & secrets
# ==========================================================
.env
.env.backup
.env.production
.env.local
.env.*.local
.phpunit.result.cache
.phpunit.cache
auth.json

# ==========================================================
# Logs & rapports
# ==========================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
audit-*.md
audit-*.txt

# ==========================================================
# IDE / Éditeurs
# ==========================================================
/.idea
/.vscode
/.fleet
/.nova
/.zed
*.sublime-project
*.sublime-workspace
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# ==========================================================
# Système d'exploitation
# ==========================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__MACOSX/

# ==========================================================
# Outils de développement
# ==========================================================
Homestead.json
Homestead.yaml
/.vagrant
/.php-cs-fixer.cache
/.php_cs.cache

# ==========================================================
# Archives & fichiers temporaires
# ==========================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.swp
*.swo
*~

# ==========================================================
# Fichiers spécifiques à Claude/IA
# ==========================================================
/.claude
CLAUDE.md

# ==========================================================
# CGI (non utilisé en déploiement Laravel)
# ==========================================================
/cgi-bin
